/*
  # Cabeceras de seguridad globales
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), usb=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains

  # Content-Security-Policy
  # connect-src restringe dónde el JS puede hacer fetch/XHR/WebSocket
  # object-src y base-uri bloquean vectores de inyección clásicos
  # frame-ancestors es más fuerte que X-Frame-Options
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.onesignal.com https://onesignal.com https://api.onesignal.com https://cdn.jsdelivr.net https://esm.sh; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://onesignal.com https://cdn.onesignal.com; font-src 'self' https://fonts.gstatic.com; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://onesignal.com https://*.onesignal.com https://api.onesignal.com https://unavatar.io https://cdn.jsdelivr.net https://esm.sh; img-src 'self' data: https: blob:; worker-src 'self' blob: https://cdn.onesignal.com https://onesignal.com; frame-src 'none'; frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self';

# El Service Worker debe servirse desde el root y sin caché agresivo
/sw.js
  Cache-Control: no-cache, no-store, must-revalidate
  Service-Worker-Allowed: /

/manifest.json
  Cache-Control: public, max-age=3600

# Assets cacheables (JS/CSS sin hash → cache corto + revalidate)
/assets/*
  Cache-Control: public, max-age=300, must-revalidate

# Iconos: cache largo
/assets/icons/*
  Cache-Control: public, max-age=604800, immutable

# La config de agencia puede cachearse 5 minutos (cambia poco)
/api/config
  Cache-Control: public, max-age=300

# Las demás Pages Functions no deben cachearse
/api/*
  Cache-Control: no-store
